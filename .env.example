# ---------------------------------------------------------------------------
# Configuración del facturador ARCA. Copiá este archivo a `.env` y completalo.
# ---------------------------------------------------------------------------

# Clave para entrar a la paginita (la que tipeás en el navegador)
APP_PASSWORD=cambiame

# Clave secreta de Flask para firmar la cookie de sesión (poné cualquier string largo al azar)
FLASK_SECRET_KEY=cambiame-por-algo-aleatorio-largo

# Tu CUIT (sin guiones), el de tu monotributo
CUIT=20123456789

# Punto de venta habilitado para web service (lo das de alta en AFIP, suele ser 1, 2, 3...)
PUNTO_VENTA=1

# Entorno: "homologacion" (pruebas) o "produccion" (facturas reales)
ENTORNO=homologacion

# Concepto del comprobante:
#   1 = Productos
#   2 = Servicios
#   3 = Productos y Servicios
# Para "me ingresó plata por un trabajo" normalmente es 2 (Servicios).
CONCEPTO=2

# Rutas a tu certificado y clave privada (ver README para generarlos)
CERT_PATH=certs/homo.crt
KEY_PATH=certs/homo.key
