# ---------------------------------------------------------------------------
# Config de la PLATAFORMA (SaaS multiusuario). Copiá a `.env` y completá.
# Los datos fiscales de cada usuario (CUIT, punto de venta, actividad, etc.)
# NO van acá: se cargan por usuario desde la web (tabla tenant_config).
# ---------------------------------------------------------------------------

# Clave secreta de Flask para firmar la sesión (string largo al azar):
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=cambiame-por-algo-aleatorio-largo

# Certificado/clave del COMPUTADOR FISCAL de la plataforma (el que cada cliente
# autoriza en su AFIP). Un solo par para todos los tenants.
PLATFORM_CERT_PATH=certs/prod.crt
PLATFORM_KEY_PATH=certs/prod.key

# CUIT y alias del computador fiscal (se muestran en el onboarding para que el
# cliente sepa a quién autorizar en Administrador de Relaciones).
PLATFORM_CUIT=20242454600
PLATFORM_ALIAS=facturador

# Cookies seguras (1 = solo HTTPS). Dejar en 1 en producción (detrás de Caddy).
COOKIE_SECURE=1
